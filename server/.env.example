PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/rk-fashions
# Website address(es), comma-separated. The first is used in email links.
CLIENT_URL=http://localhost:5173
# lax when the API serves the site; none when the frontend is on another domain.
COOKIE_SAMESITE=lax

# Long random string. Lets scripts call admin APIs with "Authorization: Bearer <token>" (the dashboard uses admin sign-in).
ADMIN_TOKEN=

# Studio inbox that receives new enquiry / appointment notifications.
STUDIO_EMAIL=

# Email notifications (any SMTP provider: Gmail app password, Zoho, SendGrid SMTP, Amazon SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RK FASHIONS <no-reply@rkfashions.in>"

# Cloudinary (image storage). Without these, uploads are saved to server/uploads/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Session signing secret (long random string). Required in production.
JWT_SECRET=

# Payments: Razorpay keys (use rzp_test_… keys while testing). Leave empty to hide online payment.
# Cash on delivery is off unless set to true.
COD_ENABLED=false
SHIPPING_FEE=0
# Razorpay webhook (Dashboard → Webhooks → add https://<your-site>/api/payments/razorpay/webhook,
# events payment.captured + order.paid, and paste the same secret here).
RAZORPAY_WEBHOOK_SECRET=
